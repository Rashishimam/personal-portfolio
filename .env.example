# =========================================================================
# CONTACT FORM & TRANSACTIONAL EMAIL CONFIGURATION
# =========================================================================

# Destination email for all portfolio messages
CONTACT_TO_EMAIL=imamrasish786@gmail.com
VITE_CONTACT_EMAIL=imamrasish786@gmail.com

# (Optional) Resend Transactional Email API Key for two-way threaded conversations
# Sign up free at https://resend.com to generate an API key
# Example: RESEND_API_KEY=re_123456789abcdef
RESEND_API_KEY=

# Verified sender email address / domain
# By default, Resend provides 'Portfolio Contact <onboarding@resend.dev>' for testing
# When you verify your own domain, update to: 'Portfolio <contact@yourdomain.com>'
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Rate limit cooldown period in seconds
VITE_RATE_LIMIT_SECONDS=45
